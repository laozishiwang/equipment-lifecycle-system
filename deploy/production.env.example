# 每次部署前生成随机值；不要提交 .env.production。
SITE_DOMAIN=equipment.example.com
# 私有照片容量上限 5 GiB，磁盘至少保留 2 GiB；按服务器实际容量调整。
EMS_PRIVATE_UPLOAD_MAX_BYTES=5368709120
EMS_PRIVATE_UPLOAD_MIN_FREE_BYTES=2147483648
DB_ROOT_PASSWORD=replace-with-long-random-secret
DB_PASSWORD=replace-with-another-long-random-secret
TOKEN_SECRET=replace-with-a-long-random-token-secret
# Base64 编码的 BCrypt 密码哈希；不要放明文密码或示例哈希。
ADMIN_BCRYPT_BASE64=replace-with-base64-bcrypt-hash
